+def _normalize_errors(errors):
+    """命令模块 errors[] 规范化;缺 code 即整体拒绝(错误序列化必须含 code)。"""
+    normalized = []
+    for item in errors or []:
+        if not isinstance(item, dict) or not isinstance(item.get("code"), str) or not item["code"]:
+            return None
+        normalized.append(
