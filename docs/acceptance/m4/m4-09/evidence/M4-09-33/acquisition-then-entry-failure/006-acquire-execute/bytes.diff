+```bash
+# 仅在已批准隔离终端中构造 A；不 export HOME，不改变当前登录会话。
+umask 077
+PREP_RUN=$(mktemp -d /private/tmp/mem-sharing-m4-10.XXXXXX)
+PREP_HOME="$PREP_RUN/home"
+PREP_EVIDENCE="$PREP_RUN/evidence"
+mkdir -m 700 "$PREP_HOME" "$PREP_EVIDENCE"
