+def _prescan_single_use(argv):
+    """argparse 对重复单值参数会静默取后者;合同要求重复使用必须拒绝,先扫描原始 argv。"""
+    counts = {}
+    for token in argv:
+        if not isinstance(token, str):
+            continue
+        for flag in _SINGLE_USE_FLAGS:
+            if token == flag or token.startswith(flag + "="):
