+        if name not in values:
+            raise PathsError("unknown_placeholder", "未知占位符 {%s}(仅允许 {home}/{project})" % name)
+        value = values[name]
+        if not isinstance(value, str) or not os.path.isabs(value):
+            raise PathsError("path_invalid", "占位符 {%s} 的值必须是绝对路径: %r" % (name, value))
