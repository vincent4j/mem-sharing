+def expand_path(template, *, home, project=None):
+    """展开 {home}/{project} 占位符;展开结果必须是绝对路径。
+
+    home/project 仅在模板实际引用时要求为非空绝对路径字符串;不 resolve 符号链接、
+    不做规范化,保留落点原样(registry 记录落点,链接目标另记)。
+    """
