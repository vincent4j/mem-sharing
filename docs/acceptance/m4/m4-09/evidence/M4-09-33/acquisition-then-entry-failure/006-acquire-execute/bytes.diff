+    return {
+        "runtime_layout": runtime.describe(),
+        "status": STATUS_GAPS if any_gap else STATUS_COMPLETED,
+        "projects": projects,
+        "changes": [],
+        "warnings": warnings,
+        "errors": errors,
+        "approval_required": False,
