+def _detect_interactive(stdin, stdout):
+    try:
+        return bool(stdin.isatty() and stdout.isatty())
+    except Exception:
+        return False
+
+
+def main(
+    argv=None,
+    *,
+    stdin=None,
+    stdout=None,
+    stderr=None,
+    platform=None,
+    interactive=None,
+    table_path=None,
+    home=None,
+):
+    """执行 CLI 并返回进程退出码;stdin/stdout/platform 等注入点供测试使用。
+
+    stdout 恒输出单个 JSON envelope;stderr 输出人读诊断。帮助文本(-h)由 argparse
