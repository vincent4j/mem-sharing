+    index_path=runtime.root/'memories/MEMORY.md'
+    output(index_path,{'kind':'file','sha256':legacy.digest(index),'mode':0o600},content=index)
+    # v1.11(2026-10-30 裁定):R 不建 skills/、mcp/,首装结构仅内容两目录+台账+备份。
