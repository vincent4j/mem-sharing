++"""Read-only v0 inventories and byte-preserving copy manifests (no execution)."""
++import hashlib
++import json
++import os
++import posixpath
++import re
++import stat
++import unicodedata
++from pathlib import Path
++from urllib.parse import unquote, urlsplit
