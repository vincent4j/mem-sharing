+          'effective_agents':(entry_result.get('agents') or {}).get('effective',[]),'entry_plan':entry_plan,'entry_inputs':saved_inputs,
+          'observations':scene['observations'],'scene_sha256':legacy.digest(legacy.encoded(scene['observations'])),
