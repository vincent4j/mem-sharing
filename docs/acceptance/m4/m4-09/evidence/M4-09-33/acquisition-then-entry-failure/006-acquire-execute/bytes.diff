+def _observe_path(path):
+    """只读识别落点类型:('file', bytes)|('symlink',None)|('other',None)|('absent',None)。"""
+    try:
+        mode = os.lstat(path).st_mode
+    except OSError:
+        return "absent", None
+    if stat_module.S_ISLNK(mode):
+        return "symlink", None
+    if stat_module.S_ISREG(mode):
+        try:
+            return "file", Path(path).read_bytes()
+        except OSError:
+            return "other", None
+    return "other", None
