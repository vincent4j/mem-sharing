+def _default_search_paths():
+    raw = os.environ.get("PATH", "")
+    ordered, seen = [], set()
+    for item in raw.split(os.pathsep):
+        if item and item not in seen:
+            seen.add(item)
+            ordered.append(item)
+    return ordered
