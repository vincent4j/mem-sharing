+COMMAND = 'organize-user-rules'
+_COMMON = re.compile(r'中文|语言|简洁|简体|繁体|提交|commit|风格|流程|偏好|批准|确认|测试|核验|验证|证据|先规划|先分析|先计划|勿|不要|禁止|不得|format|concise|approval|language', re.I)
