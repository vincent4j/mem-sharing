+    return evidence
+
+
+def approval_without_evidence(approval):
+    return {key: value for key, value in approval.items() if key not in ('confirmed_at', 'reference')}
+
+
+def _seal(plan):
+    plan['plan_sha256'] = legacy.digest(legacy.encoded(plan))
+    return plan
+
+
+def _entry_preview(request):
