+    for name in requested:
+        if name not in AGENTS:
+            raise PathsError("invalid_agent", "未知执行器: %r(仅 codex/claude/workbuddy)" % (name,))
+        if name in seen:
+            raise PathsError("invalid_agent", "重复执行器: %s(--agent 值必须唯一)" % name)
