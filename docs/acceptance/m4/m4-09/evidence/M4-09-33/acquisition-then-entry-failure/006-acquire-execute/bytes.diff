++def _files(item):
++    result = {f['path']: (f['sha256'], f['mode'] & 0o555) for f in item['release']['files']}
++    result['.agm-code-manifest.json'] = (legacy.digest(bytes.fromhex(item['marker_hex'])), 0o400)
++    return result
