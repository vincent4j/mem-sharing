+            STATUS_FAILED,
+            errors=[
+                error_item(
+                    "internal_error",
+                    "未预期的内部错误: %s" % exc,
+                    recovery="请把上述信息交给维护者;本次未执行任何写入",
+                )
+            ],
+        )
+    print(json.dumps(envelope, ensure_ascii=False, indent=2), file=out_stream)
