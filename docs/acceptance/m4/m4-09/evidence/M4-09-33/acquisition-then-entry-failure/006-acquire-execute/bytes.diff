+        summary = "全部支持候选均可检查且不存在,无 hint"
+    return {
+        "agent": agent,
+        "status": status,
+        "observed_at": _utc_now(),
+        "rules_version": DETECT_RULES_VERSION,
+        "summary": summary,
+        "hints": hints,
+        "evidence": records,
+    }
