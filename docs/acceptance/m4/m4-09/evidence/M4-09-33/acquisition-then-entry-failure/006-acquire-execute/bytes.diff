+    request = build_request(
+        command,
+        namespace,
+        agents=agents,
+        approval=approval,
+        table=table,
+        platform_key=platform_key,
+        platform_config=platform_config,
+        table_path=table_path or agm_paths.default_table_path(),
+        interactive=interactive,
