+                  'source_url': OFFICIAL, 'commit': commit, 'version': version, 'staging': str(stage),
+                  'changes': [{'path': str(stage), 'operation': 'clone_pinned_source_and_manifest'}]})
+
+
+def execute_acquisition(plan, approval):
