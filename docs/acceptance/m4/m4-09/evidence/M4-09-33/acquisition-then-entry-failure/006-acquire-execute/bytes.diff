+    next_action = None
+    if any_gap:
+        next_action = (
+            "check 发现缺口:suggestion=enable 的缺失项可运行 enable-memory 修复(写命令需授权/批准文件),"
+            "drifted/conflict/manual 项先人工核对;缺口清单见 projects[].gaps"
