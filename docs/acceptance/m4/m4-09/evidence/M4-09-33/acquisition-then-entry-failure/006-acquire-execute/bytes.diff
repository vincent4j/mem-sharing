+def _envelope_from_result(command, result):
+    """把命令模块返回 dict 规范化为输出 envelope(字段合同固定,status 必填)。"""
+    if not isinstance(result, dict) or result.get("status") not in _STATUS_EXIT:
+        return make_envelope(
+            command,
+            STATUS_FAILED,
+            errors=[
