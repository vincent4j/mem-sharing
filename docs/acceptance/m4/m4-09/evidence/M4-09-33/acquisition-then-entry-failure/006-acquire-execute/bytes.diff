+        return units
+    for obj in ledger["shared_objects"].values():
+        units[(obj["path"], obj["marker"]["start"] if obj["marker"] else None)] = obj
+    for obj in ledger["machine"]["objects"].values():
+        units[(obj["path"], obj["marker"]["start"] if obj["marker"] else None)] = obj
+    return units
