+_SIGNAL_FIELD_SETS = {
+    "directory_exists": frozenset(("kind", "path", "strength")),
+    "path_executable": frozenset(("kind", "executable", "package_name", "strength")),
+    "macos_app_bundle": frozenset((
+        "kind", "bundle_name", "product_name", "require_bundle_version",
