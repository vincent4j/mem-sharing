+        super().__init__(message)
+        self.code = code
+        self.manifest = None if manifest is None else str(manifest)
+        self.recovery_errors = list(recovery_errors or [])
+
+
+def _hash(data):
+    return hashlib.sha256(data).hexdigest()
+
+
