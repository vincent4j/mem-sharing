+                       'before':item['before'],'after':item['after']} for item in outputs]
+        + [{'path':p,'operation':'mkdir','before':_node(p)} for p in plan['directories'] if _node(p)['kind']=='absent']
+        + (entry_plan or {}).get('changes',[])
