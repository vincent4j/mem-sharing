+    if "{" in expanded or "}" in expanded:
+        raise PathsError("unknown_placeholder", "路径含未展开占位符: %s" % expanded)
+    if not os.path.isabs(expanded):
+        raise PathsError("path_invalid", "展开后不是绝对路径: %s" % expanded)
+    return expanded
