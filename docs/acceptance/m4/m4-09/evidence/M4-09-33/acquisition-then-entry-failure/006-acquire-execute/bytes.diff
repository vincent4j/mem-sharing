+            warnings=["非交互环境(非 TTY)无法提问;不从 stdin 猜测 yes,不因环境变量自动批准"],
+            next_action=INSTALL_NEXT_ACTION if not os.path.lexists(agm_layout.resolve_layout(home).registry) else (
