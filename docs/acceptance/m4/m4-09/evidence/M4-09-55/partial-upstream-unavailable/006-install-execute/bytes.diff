+        summary = verified[0]["detail"]
+    elif failed:
+        status = "unknown"
+        summary = "候选核验失败/权限错误: " + "; ".join(record["detail"] for record in failed)
+    elif any(hint["exists"] for hint in hints):
+        status = "unknown"
+        summary = "仅有残留目录 hint,无强安装信号: " + "; ".join(
+            hint["path"] for hint in hints if hint["exists"])
