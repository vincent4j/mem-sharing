+        plan.pop('confirmed_at'); plan.pop('reference')
+        return plan, result
+    if result['status'] != 'completed':
+        raise InstallError(json.dumps(result['errors'], ensure_ascii=False), 'entry_preflight_failed')
+    return None, result
