+        self.after[Path(path)] = Snapshot("file", new, snap.mode if snap.kind == "file" else 0o600)
+        self.objects[oid] = self._new_object(oid, "user_convention", path, agent, "created",
+                                             marker=BASE_MARKER, value=desired)
