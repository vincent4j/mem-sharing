+    except (ValueError,OSError,KeyError,TypeError) as exc:
+        result.update(scene='bad_registry' if 'layout' in result and Path(result['layout']['registry']).exists() else 'abnormal', channel='stop')
+        result['errors'].append(str(exc))
+    return result
