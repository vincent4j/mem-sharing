+def _content_scene(plan):
+    imported=plan['legacy_import']
+    if not imported:return
+    # §23 源/目标分离后 v0 源侧零写入:任何相对批准清单的变化都是漂移。
+    now=legacy.inventory(imported['source_root'])
+    if now['tree_sha256']!=imported['source_tree_sha256']:
