+            return result
+        # §23:v0 源与目标分离——历史位置 ~/.agents-group(legacy_root)只作只读
+        # v0 源,完整枚举进 observations 绑定 scene;产品自身永不写入该目录。
+        observations.update(_walk(runtime.legacy_root))
