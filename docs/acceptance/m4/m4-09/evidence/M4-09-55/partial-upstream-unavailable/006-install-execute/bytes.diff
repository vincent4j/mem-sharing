+def _nearest_package_json(start_dir):
+    current = Path(start_dir)
+    for _ in range(_MAX_PACKAGE_WALK):
+        candidate = current / "package.json"
+        if candidate.is_file():
+            return candidate
+        if current.parent == current:
+            break
+        current = current.parent
+    return None
+
