+               + user_entries.GOVERNANCE_RULES_TEXT + '\n'
+               + user_entries.CLAUDE_FALLBACK_TEXT + '\n'
+               + user_entries.agent_group_menu_text(runtime.code) + '\n').encode()
+        output(runtime.root/'memories/topics/使用约定.md',
