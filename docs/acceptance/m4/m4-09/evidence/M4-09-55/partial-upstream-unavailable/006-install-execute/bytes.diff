+        _fail('CK rule marker is malformed', 'ck_readback_failed')
+    if not raw.count(start):
+        return None
+    first, last = raw.index(start), raw.index(end)+len(end)
+    if last <= first:
+        _fail('CK rule marker order is invalid', 'ck_readback_failed')
+    return first, last
