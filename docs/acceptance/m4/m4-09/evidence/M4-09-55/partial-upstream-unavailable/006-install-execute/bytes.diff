+def _import_rule_warnings(agent, platform_config, *, home, checkout, objects):
+    """import 模式入口文件的非引用规则增长告警(DESIGN §4.2 瘦身终态)。
+
+    只读计算:受管块(登记对象或已知标记对)与裸 @AGENTS.md 引用行之外仍有
+    非空白内容即告警;不修改任何字节。
+    """
