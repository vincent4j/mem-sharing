+def _rule_range(raw, agent):
+    middle = ':workbuddy' if agent == 'workbuddy' else ''
+    start = ('<!-- context-keeper'+middle+':start -->').encode()
+    end = ('<!-- context-keeper'+middle+':end -->').encode()
