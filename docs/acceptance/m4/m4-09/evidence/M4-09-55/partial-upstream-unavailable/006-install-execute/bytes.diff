+def empty_registry():
+    """An explicit uninstalled schema-v3 model, never an on-disk initializer."""
+    return {"schema_version": 3, "projects": {}, "shared_objects": {},
+            "product": None, "machine": {"agents": {}, "objects": {}},
+            "migration": None, "legacy_import": None}
+
