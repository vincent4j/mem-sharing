+                if kind == 'unknown_field': raw['extra'] = True
+                if kind == 'machine_damage': raw['product']['installation_status'] = 'BOGUS'
+                if kind == 'unidentifiable_project': raw['projects'][str(self.root)]['main_checkout'] = '/different'
